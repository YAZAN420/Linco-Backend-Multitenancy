generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum DemoMemberRole {
  OWNER
  MANAGER
  TRAINER
}

enum CourseVisibility {
  PUBLIC   
  PRIVATE  
}

enum AccessMethod {
  CREATED  
  PURCHASED
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
  CANCELED    
}

enum PurchaseType {
  COURSE
}

enum JobTitle {
  INTERN
  JUNIOR
  SENIOR
}

enum PlanTier {
  STARTER
  PRO
  ENTERPRISE
}


model User {
  id                    String                 @id
  firstName             String
  lastName              String
  email                 String                 @unique
  password              String?
  birthDate             DateTime?
  imagePath             String
  refreshToken          String?
  role                  UserRole                   @default(USER)
  twoFactorSecret       String?
  isTwoFactorEnabled    Boolean                @default(false)
  isEmailVerified       Boolean                @default(false)
  emailVerificationToken String?
  emailVerificationExpires DateTime?
  passwordResetToken    String?
  passwordResetExpires  DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  demoMemberships       DemoMember[]
  ownedDemos            Demo[]                 @relation("DemoOwner")
  payments              Payment[]
  examAttempts          ExamAttempt[]
}

model DemoMember {
  id        String   @id
  userId    String
  demoId    String
  role      DemoMemberRole   @default(TRAINER) 
  joinedAt  DateTime @default(now())
  updatedAt             DateTime               @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  demo      Demo     @relation(fields: [demoId], references: [id], onDelete: Cascade)
  managedDepartments Department[]

  discussionQuestions DiscussionQuestion[]
  discussionAnswers   DiscussionAnswer[]

  accessibleDepartments DepartmentMember[]

  @@unique([userId, demoId])
}

model DepartmentMember {
  id           String     @id @default(uuid())
  departmentId String
  demoMemberId String

  jobTitle     JobTitle   @default(JUNIOR)
  assignedAt   DateTime   @default(now())
  updatedAt  DateTime @updatedAt

  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  demoMember   DemoMember @relation(fields: [demoMemberId], references: [id], onDelete: Cascade)

  @@unique([departmentId, demoMemberId])
  @@index([departmentId])
  @@index([demoMemberId])
}

model Department {
  id         String   @id
  name       String
  description  String
  managerId  String
  demoId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  manager DemoMember @relation(fields: [managerId], references: [id], onDelete: Restrict)
  demo       Demo     @relation(fields: [demoId], references: [id], onDelete: Cascade)
  courses    DepartmentCourse[]

  members DepartmentMember[]
}

model Demo {
  id           String       @id
  name         String
  imagePath String
  description  String
  plan PlanTier @default(STARTER)

  ownerId      String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  departments  Department[]
  members      DemoMember[]

  owner        User         @relation("DemoOwner", fields: [ownerId], references: [id])

  courses     Course[]
  assets     Asset[]
}

model Course {
  id         String           @id 
  title      String
  imagePath String
  description String
  visibility CourseVisibility @default(PRIVATE)
  price      Float?          

  demoId     String
  demo       Demo             @relation(fields: [demoId], references: [id], onDelete: Cascade)

  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  tags        Tag[]
  assets     Asset[]
  sections   Section[]
  payments   Payment[]
}

model Section {
  id            String   @id 
  title         String
  order         Int
  
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade) 
  lessons       Lesson[]
  questionsBank QuestionsBank[]
  exam          Exam?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([courseId]) 
  @@unique([courseId, order])
  @@unique([courseId, title])
}

model Lesson {
  id          String   @id 
  title       String
  videoUrl    String
  subTitleUrl String?
  order       Int      
  sectionId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade) 
  attachments  Attachment[]
  questions DiscussionQuestion[]

  @@index([sectionId]) 
  @@unique([sectionId, order])
  @@unique([sectionId, title])
}

model Attachment {
  id        String   @id 
  name      String  
  path      String
  mimeType  String?
  lessonId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model Exam {
  id                String    @id 
  sectionId         String    @unique
  title             String
  numberOfQuestions Int
  durationMinutes   Int @default(1000)

  section           Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)  
  attempts          ExamAttempt[]
 
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([sectionId]) 
}

model QuestionsBank {
  id          String            @id @default(cuid())
  sectionId   String
  text        String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  section     Section           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  choices     QuestionChoice[]
}

model QuestionChoice {
  id          String            @id @default(cuid())
  questionId  String
  text        String
  isCorrect   Boolean

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  question    QuestionsBank      @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model ExamAttempt {
  id          String            @id @default(cuid())
  userId      String
  examId      String
  score       Int               @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exam         Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, examId])
}

model Asset {
  id           String       @id
  demoId       String
  courseId     String
  accessMethod AccessMethod
  acquiredAt   DateTime     @default(now())
  updatedAt DateTime @updatedAt
  departments     DepartmentCourse[]

  demo         Demo         @relation(fields: [demoId], references: [id], onDelete: Cascade)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([demoId, courseId])
}

model DepartmentCourse {
  id           String       @id
  departmentId String
  assetId     String
  assignedAt   DateTime   @default(now())
  updatedAt DateTime @updatedAt

  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  asset        Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([departmentId, assetId]) 
}


model DiscussionQuestion {
  id           String             @id @default(uuid())
  lessonId     String             
  demoMemberId String             
  content      String             @db.Text 
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  lesson       Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  demoMember   DemoMember         @relation(fields: [demoMemberId], references: [id], onDelete: Cascade)
  answers      DiscussionAnswer[] 

  @@index([lessonId]) 
}

model DiscussionAnswer {
  id           String             @id @default(uuid())
  discussionId String             
  demoMemberId String             
  content      String             @db.Text 
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  discussion   DiscussionQuestion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  demoMember   DemoMember         @relation(fields: [demoMemberId], references: [id], onDelete: Cascade)

  @@index([discussionId]) 
}


model Payment {
  id                    String        @id @default(uuid())
  userId                String
  
  purchaseType          PurchaseType  @default(COURSE)
  courseId              String       
  
  amount                Float
  currency              String        @default("USD")
  status                PaymentStatus @default(PENDING)
  
  stripeSessionId       String        @unique 
  stripePaymentIntentId String?       @unique 
  
  paymentMethod         String?       
  receiptUrl            String?       
  failureReason         String?       
  
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course                Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeSessionId])
}


model Tag {
  id        String   @id @default(cuid())
  name      String   @unique 
  courses   Course[] 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}