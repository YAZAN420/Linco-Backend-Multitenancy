generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum DemoMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum DepartmentMemberRole {
  MANAGER
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  AUDIO
}

enum CourseVisibility {
  PUBLIC   
  PRIVATE  
}

enum AccessMethod {
  CREATED  
  PURCHASED
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
}

enum PaymentType {
  COURSE
  SUBSCRIPTION
}

enum PurchaseType {
  COURSE
}

enum JobTitle {
  INTERN
  JUNIOR
  SENIOR
}

enum PlanTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum SubscriptionStatus {
  TRIALING
  EXPIRED
  PENDING
  ACTIVE
  CANCELED
  PAST_DUE
}

enum InquiryStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  id                    String                 @id
  firstName             String
  lastName              String
  email                 String                 @unique
  password              String?
  birthDate             DateTime?
  imagePath             String
  refreshToken          String?
  role                  UserRole                   @default(USER)
  twoFactorSecret       String?
  isTwoFactorEnabled    Boolean                @default(false)
  isEmailVerified       Boolean                @default(false)
  emailVerificationToken String?
  emailVerificationExpires DateTime?
  passwordResetToken    String?
  passwordResetExpires  DateTime?
  stripeCustomerId      String?   @unique

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  receivedInvitations   Invitation[] @relation("ReceivedInvitations")
  sentInvitations       Invitation[] @relation("SentInvitations")
  demoMemberships       DemoMember[]
  ownedDemos            Demo[]                 @relation("DemoOwner")
  payments              Payment[]
}

model DemoMember {
  id        String   @id
  userId    String
  demoId    String
  role      DemoMemberRole   @default(MEMBER) 
  joinedAt  DateTime @default(now())
  updatedAt             DateTime               @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  demo      Demo     @relation(fields: [demoId], references: [id], onDelete: Cascade)
  managedDepartments Department[]

  discussionQuestions DiscussionQuestion[]
  discussionAnswers   DiscussionAnswer[]

  accessibleDepartments DepartmentMember[]
  createdInquiries      Inquiry[] 
  inquiryMessages       InquiryMessage[]
  examAttempts          ExamAttempt[]

  @@unique([userId, demoId])
}

model DepartmentMember {
  id           String     @id @default(uuid())
  departmentId String
  demoMemberId String

  jobTitle     JobTitle   @default(JUNIOR)
  role DepartmentMemberRole @default(MEMBER)
  assignedAt   DateTime   @default(now())
  updatedAt  DateTime @updatedAt

  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  demoMember   DemoMember @relation(fields: [demoMemberId], references: [id], onDelete: Cascade)

  messages DepartmentMessage[]
  @@unique([departmentId, demoMemberId])
  @@index([departmentId])
  @@index([demoMemberId])
}

model Department {
  id         String   @id
  name       String
  description  String
  managerId  String
  demoId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  manager DemoMember @relation(fields: [managerId], references: [id], onDelete: Restrict)
  demo       Demo     @relation(fields: [demoId], references: [id], onDelete: Cascade)
  courses    DepartmentCourse[]

  members DepartmentMember[]
  messages DepartmentMessage[]
}

model Demo {
  id           String       @id
  name         String
  imagePath String
  description  String
  plan PlanTier @default(FREE)

  stripeSubscriptionId   String?   @unique
  subscriptionStatus   SubscriptionStatus  @default(TRIALING)
  currentPeriodEnd       DateTime

  ownerId      String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  departments  Department[]
  members      DemoMember[]
  invitations  Invitation[]
  owner        User         @relation("DemoOwner", fields: [ownerId], references: [id])

  payments  Payment[]
  courses     Course[]
  assets     Asset[]
  inquiries Inquiry[]
}

model Course {
  id         String           @id 
  title      String
  imagePath String
  description String
  visibility CourseVisibility @default(PRIVATE)
  price      Float         
  isPublished Boolean @default(false)

  demoId     String
  demo       Demo             @relation(fields: [demoId], references: [id], onDelete: Cascade)

  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  payments Payment[]
  tags        Tag[]
  assets     Asset[]
  sections   Section[]
  faqs        CourseFaq[]
}

model CourseFaq {
  id        String   @id 
  question  String   @db.Text
  answer    String   @db.Text
  courseId  String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Section {
  id            String   @id 
  title         String
  order         Int
  
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade) 
  lessons       Lesson[]
  questionsBank QuestionsBank[]
  exam          Exam?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([courseId]) 
  @@unique([courseId, order])
  @@unique([courseId, title])
}

model Lesson {
  id          String   @id 
  title       String
  description String 
  videoUrl    String
  duration    Int
  subTitleUrl String?
  order       Int      
  sectionId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  section     Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade) 
  attachments  Attachment[]
  questions DiscussionQuestion[]

  @@index([sectionId]) 
  @@unique([sectionId, order])
  @@unique([sectionId, title])
}

model Attachment {
  id        String   @id 
  name      String  
  path      String
  mimeType  String?
  lessonId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model Exam {
  id                String    @id 
  sectionId         String    @unique
  title             String
  numberOfQuestions Int
  durationMinutes   Int @default(60)

  section           Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)  
  attempts          ExamAttempt[]
 
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([sectionId]) 
}

model QuestionsBank {
  id          String            @id 
  sectionId   String
  question        String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  section     Section           @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  choices     QuestionChoice[]
}

model QuestionChoice {
  id          String            @id 
  questionId  String
  choice        String
  isCorrect   Boolean

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  question    QuestionsBank      @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model ExamAttempt {
  id          String            @id 
  demoMemberId      String
  examId      String
  score       Int               @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exam         Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  demoMember        DemoMember @relation(fields: [demoMemberId], references: [id], onDelete: Cascade)
}

model Asset {
  id           String       @id
  demoId       String
  courseId     String
  accessMethod AccessMethod
  acquiredAt   DateTime     @default(now())
  updatedAt DateTime @updatedAt
  departments     DepartmentCourse[]

  demo         Demo         @relation(fields: [demoId], references: [id], onDelete: Cascade)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([demoId, courseId])
}

model DepartmentCourse {
  id           String       @id
  departmentId String
  assetId     String
  assignedAt   DateTime   @default(now())
  updatedAt DateTime @updatedAt

  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  asset        Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([departmentId, assetId]) 
}


model DiscussionQuestion {
  id           String             @id
  lessonId     String             
  demoMemberId String             
  content      String             @db.Text 
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  lesson       Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  demoMember   DemoMember         @relation(fields: [demoMemberId], references: [id], onDelete: Cascade)
  answers      DiscussionAnswer[] 

  @@index([lessonId]) 
}

model DiscussionAnswer {
  id           String             @id 
  discussionId String             
  demoMemberId String             
  content      String             @db.Text 
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  discussion   DiscussionQuestion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  demoMember   DemoMember         @relation(fields: [demoMemberId], references: [id], onDelete: Cascade)

  @@index([discussionId]) 
}

model Invitation {
  id         String           @id 
  demoId     String
  receiverId String 
  senderId   String 
  role       DemoMemberRole   @default(MEMBER)
  status     InvitationStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  demo     Demo @relation(fields: [demoId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedInvitations", fields: [receiverId], references: [id], onDelete: Cascade)
  sender   User @relation("SentInvitations", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([receiverId]) 
  @@index([demoId,receiverId])
}

model Payment {
  id                     String    @id 
  amount                 Int    
  currency               String    @default("USD")
  type PaymentType @default(SUBSCRIPTION)
  plan PlanTier?
  status                 PaymentStatus @default(PENDING)
  
  stripeInvoiceId        String?   @unique 
  stripePaymentIntentId  String?   @unique 

  createdAt            DateTime  @default(now())
  updatedAt              DateTime @updatedAt

  userId                 String
  user                   User      @relation(fields: [userId], references: [id])
  
  demoId                 String?
  demo                   Demo?     @relation(fields: [demoId], references: [id])

  courseId               String?
  course                 Course?   @relation(fields: [courseId], references: [id]) 
}

model Tag {
  id        String   @id 
  name      String   @unique 
  courses   Course[] 
}

model Inquiry {
  id            String  @id 

  subject       String

  creatorId     String
  demoId        String

  creator       DemoMember    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  demo          Demo    @relation(fields: [demoId], references: [id], onDelete: Cascade)

  status        InquiryStatus @default(PENDING)

  messages      InquiryMessage[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([demoId])
  @@index([creatorId])
}

model InquiryMessage {
  id String @id 

  inquiryId String
  inquiry   Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  senderId String
  sender   DemoMember @relation(fields: [senderId], references: [id], onDelete: Cascade)

  message String

  createdAt DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([inquiryId])
}

model DepartmentMessage {
  id           String   @id 

  departmentId String
  senderId     String

  type         MessageType @default(TEXT)

  content      String? @db.Text

  fileUrl     String?
  fileName     String?
  mimeType     String?
  fileSize     Int?

  replyToId    String?

  isEdited     Boolean @default(false)
  isDeleted    Boolean @default(false)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  sender       DepartmentMember @relation(fields: [senderId], references: [id], onDelete: Cascade)

  replyTo      DepartmentMessage?  @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      DepartmentMessage[] @relation("Replies")

  @@index([departmentId, createdAt])
}