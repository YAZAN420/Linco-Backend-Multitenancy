generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum DemoMemberRole {
  TRAINER
  MANAGER
}

enum CourseVisibility {
  PUBLIC   
  PRIVATE  
}

enum AccessMethod {
  CREATED  
  PURCHASED  
}

model User {
  id                    String                 @id
  firstName             String
  lastName              String
  email                 String                 @unique
  password              String
  birthDate             DateTime
  imagePath             String
  refreshToken          String?
  role                  UserRole                   @default(USER)
  twoFactorSecret       String?
  isTwoFactorEnabled    Boolean                @default(false)
  isEmailVerified       Boolean                @default(false)
  emailVerificationToken String?
  passwordResetToken    String?
  passwordResetExpires  DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  demoMemberships       DemoMember[]
  ownedDemos            Demo[]                 @relation("DemoOwner")
}

model DemoMember {
  id        String   @id 
  userId    String
  demoId    String
  role      DemoMemberRole   @default(TRAINER) 
  joinedAt  DateTime @default(now())
  updatedAt             DateTime               @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  demo      Demo     @relation(fields: [demoId], references: [id], onDelete: Cascade)
  managedDepartments Department[]

  @@unique([userId, demoId])
}



model Department {
  id         String   @id
  name       String
  managerId  String
  demoId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  manager DemoMember @relation(fields: [managerId], references: [id], onDelete: Restrict)
  demo       Demo     @relation(fields: [demoId], references: [id], onDelete: Cascade)
  // courses    DepartmentCourse[]
}

model Demo {
  id           String       @id
  name         String
  ownerId      String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  departments  Department[]
  members      DemoMember[]

  owner        User         @relation("DemoOwner", fields: [ownerId], references: [id])

  authoredCourses Course[]        @relation("AuthoredCourses")
  // inventories     DemoInventory[]
}

model Course {
  id            String             @id @default(uuid())
  title         String
  visibility    CourseVisibility   @default(PRIVATE)
  price         Float?          

  authorDemoId  String?
  authorDemo    Demo?              @relation("AuthoredCourses", fields: [authorDemoId], references: [id], onDelete: SetNull)

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  // demoInventories  DemoInventory[]   
  // departmentAssignments DepartmentCourse[] 
}

