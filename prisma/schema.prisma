generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum DemoMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum InquirySenderType {
  ADMIN
  SYSTEM
  OWNER
}

enum DepartmentMemberRole {
  MANAGER
  MEMBER
}

enum LiveStreamStatus {
  SCHEDULED
  LIVE
  ENDED
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  AUDIO
}

enum CourseVisibility {
  PUBLIC
  PRIVATE
}

enum AccessMethod {
  CREATED
  PURCHASED
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
}

enum PaymentType {
  COURSE
  SUBSCRIPTION
}

enum PurchaseType {
  COURSE
}

enum JobTitle {
  INTERN
  JUNIOR
  SENIOR
}

enum PlanTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum SubscriptionStatus {
  TRIALING
  EXPIRED
  ACTIVE
  CANCELED
}

enum InquiryStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id                       String    @id
  firstName                String
  lastName                 String
  email                    String    @unique
  password                 String?
  birthDate                DateTime?
  imagePath                String
  refreshToken             String?
  role                     UserRole  @default(USER)
  twoFactorSecret          String?
  isTwoFactorEnabled       Boolean   @default(false)
  isEmailVerified          Boolean   @default(false)
  emailVerificationToken   String?
  emailVerificationExpires DateTime?
  passwordResetToken       String?
  passwordResetExpires     DateTime?
  stripeCustomerId         String?   @unique

  status       UserStatus @default(ACTIVE)
  lastActiveAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  receivedInvitations Invitation[] @relation("ReceivedInvitations")
  sentInvitations     Invitation[] @relation("SentInvitations")
  demoMemberships     DemoMember[]
  ownedDemos          Demo[]       @relation("DemoOwner")
  payments            Payment[]
  fcmTokens           FcmToken[]

  @@index([role, status, createdAt, id])
  @@index([emailVerificationToken])
  @@index([passwordResetToken])
}

model DemoMember {
  id        String         @id
  userId    String
  demoId    String
  role      DemoMemberRole @default(MEMBER)
  joinedAt  DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  demo               Demo         @relation(fields: [demoId], references: [id], onDelete: Cascade)
  managedDepartments Department[]

  discussionQuestions DiscussionQuestion[]
  discussionAnswers   DiscussionAnswer[]

  accessibleDepartments   DepartmentMember[]
  createdInquiries        Inquiry[]
  createdInquiriesReplies InquiryReply[]
  examAttempts            ExamAttempt[]
  certifications          Certification[]

  @@unique([userId, demoId])
  @@index([demoId, joinedAt, id])
  @@index([role, joinedAt, userId])
}

model DepartmentMember {
  id           String @id @default(uuid())
  departmentId String
  demoMemberId String

  jobTitle   JobTitle             @default(JUNIOR)
  role       DepartmentMemberRole @default(MEMBER)
  assignedAt DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  demoMember DemoMember @relation(fields: [demoMemberId], references: [id], onDelete: Cascade)

  messages          DepartmentMessage[]
  hostedLiveStreams LiveStream[]

  @@unique([departmentId, demoMemberId])
  @@index([departmentId])
  @@index([demoMemberId])
  @@index([role, demoMemberId])
}

model Department {
  id          String   @id
  name        String
  description String
  isGroup     Boolean  @default(false)
  managerId   String
  demoId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  manager DemoMember         @relation(fields: [managerId], references: [id], onDelete: Restrict)
  demo    Demo               @relation(fields: [demoId], references: [id], onDelete: Cascade)
  courses DepartmentCourse[]

  members     DepartmentMember[]
  messages    DepartmentMessage[]
  liveStreams LiveStream[]

  @@index([demoId, createdAt, id])
}

model LiveStream {
  id           String           @id
  title        String
  description  String?
  status       LiveStreamStatus @default(SCHEDULED)
  roomName     String           @unique
  departmentId String
  hostId       String
  scheduledAt  DateTime?
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  department Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  host       DepartmentMember @relation(fields: [hostId], references: [id], onDelete: Restrict)

  @@index([departmentId, status])
  @@index([hostId])
}

model Demo {
  id                 String   @id
  name               String
  imagePath          String
  signatureImagePath String   @default("")
  description        String
  plan               PlanTier @default(FREE)

  stripeSubscriptionId String?            @unique
  subscriptionStatus   SubscriptionStatus @default(TRIALING)
  currentPeriodEnd     DateTime

  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments Department[]
  members     DemoMember[]
  invitations Invitation[]
  owner       User         @relation("DemoOwner", fields: [ownerId], references: [id])

  payments  Payment[]
  courses   Course[]
  assets    Asset[]
  inquiries Inquiry[]

  @@index([createdAt, id])
  @@index([ownerId])
  @@index([subscriptionStatus, currentPeriodEnd])
}

model Course {
  id                 String           @id
  title              String
  imagePath          String
  signatureImagePath String           @default("")
  description        String
  visibility         CourseVisibility @default(PRIVATE)
  price              Float
  isPublished        Boolean          @default(false)

  demoId String
  demo   Demo   @relation(fields: [demoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments       Payment[]
  tags           Tag[]
  assets         Asset[]
  sections       Section[]
  faqs           CourseFaq[]
  certifications Certification[]

  @@index([isPublished, createdAt, id])
  @@index([isPublished, updatedAt, id])
  @@index([demoId, isPublished, createdAt, id])
  @@index([demoId, createdAt, id])
}

model CourseFaq {
  id       String @id
  question String @db.Text
  answer   String @db.Text
  courseId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model Section {
  id    String @id
  title String
  order Int

  courseId      String
  course        Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons       Lesson[]
  questionsBank QuestionsBank[]
  exam          Exam?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, order])
  @@unique([courseId, title])
  @@index([courseId])
}

model Lesson {
  id          String   @id
  title       String
  description String
  videoUrl    String
  duration    Int
  subTitleUrl String?
  order       Int
  sectionId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  section     Section              @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  attachments Attachment[]
  questions   DiscussionQuestion[]

  @@unique([sectionId, order])
  @@unique([sectionId, title])
  @@index([sectionId])
}

model Attachment {
  id        String   @id
  name      String
  path      String
  mimeType  String?
  lessonId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model Exam {
  id                String @id
  sectionId         String @unique
  title             String
  passingScore      Int
  numberOfQuestions Int
  durationMinutes   Int    @default(60)

  section  Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  attempts ExamAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId])
}

model QuestionsBank {
  id        String   @id
  sectionId String
  question  String
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  choices QuestionChoice[]

  @@index([sectionId])
}

model QuestionChoice {
  id         String  @id
  questionId String
  choice     String
  isCorrect  Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  question QuestionsBank @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model ExamAttempt {
  id           String @id
  demoMemberId String
  examId       String
  score        Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exam       Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  demoMember DemoMember @relation(fields: [demoMemberId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@index([demoMemberId, examId, createdAt])
}

model Asset {
  id           String             @id
  demoId       String
  courseId     String
  accessMethod AccessMethod
  acquiredAt   DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  departments  DepartmentCourse[]

  demo   Demo   @relation(fields: [demoId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([demoId, courseId])
  @@index([demoId, acquiredAt, id])
}

model DepartmentCourse {
  id           String   @id
  departmentId String
  assetId      String
  assignedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  asset      Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([departmentId, assetId])
  @@index([departmentId])
  @@index([assetId])
}

model DiscussionQuestion {
  id           String   @id
  lessonId     String
  demoMemberId String
  content      String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lesson     Lesson             @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  demoMember DemoMember         @relation(fields: [demoMemberId], references: [id], onDelete: Cascade)
  answers    DiscussionAnswer[]

  @@index([lessonId])
  @@index([demoMemberId, lessonId])
}

model DiscussionAnswer {
  id           String   @id
  discussionId String
  demoMemberId String
  content      String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  discussion DiscussionQuestion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  demoMember DemoMember         @relation(fields: [demoMemberId], references: [id], onDelete: Cascade)

  @@index([discussionId])
  @@index([demoMemberId])
}

model Invitation {
  id         String           @id
  demoId     String
  receiverId String
  senderId   String
  role       DemoMemberRole   @default(MEMBER)
  status     InvitationStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  demo     Demo @relation(fields: [demoId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedInvitations", fields: [receiverId], references: [id], onDelete: Cascade)
  sender   User @relation("SentInvitations", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([receiverId])
  @@index([demoId, receiverId])
}

model Payment {
  id       String        @id
  amount   Int
  currency String        @default("USD")
  type     PaymentType   @default(SUBSCRIPTION)
  plan     PlanTier?
  status   PaymentStatus @default(PENDING)

  stripeInvoiceId       String? @unique
  stripePaymentIntentId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  demoId String?
  demo   Demo?   @relation(fields: [demoId], references: [id])

  courseId String?
  course   Course? @relation(fields: [courseId], references: [id])

  @@index([type, status, updatedAt, id])
  @@index([userId])
}

model Tag {
  id      String   @id
  name    String   @unique
  courses Course[]
}

model Inquiry {
  id String @id

  subject String
  message String

  creatorId String
  demoId    String

  creator DemoMember    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  demo    Demo          @relation(fields: [demoId], references: [id], onDelete: Cascade)
  reply   InquiryReply?

  status InquiryStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([demoId])
  @@index([creatorId])
}

model InquiryReply {
  id String @id

  inquiryId String  @unique
  inquiry   Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  senderType InquirySenderType
  senderId   String
  sender     DemoMember        @relation(fields: [senderId], references: [id], onDelete: Cascade)

  message String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([senderId])
}

model DepartmentMessage {
  id String @id

  departmentId String
  senderId     String

  type MessageType @default(TEXT)

  content String? @db.Text

  fileUrl  String?
  fileName String?
  mimeType String?
  fileSize Int?

  replyToId String?

  isEdited  Boolean @default(false)
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  sender     DepartmentMember @relation(fields: [senderId], references: [id], onDelete: Cascade)

  replyTo DepartmentMessage?  @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies DepartmentMessage[] @relation("Replies")

  @@index([departmentId, createdAt])
  @@index([senderId])
}

model FcmToken {
  id          String  @id
  token       String  @unique
  deviceModel String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Certification {
  id           String @id
  demoMemberId String
  courseId     String
  score        Int

  issuedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  demoMember DemoMember @relation(fields: [demoMemberId], references: [id], onDelete: Cascade)
  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, demoMemberId])
  @@index([courseId])
  @@index([demoMemberId])
  @@index([issuedAt, demoMemberId])
}

view DepartmentLeaderboard {
  id           String   @unique
  rank         Int
  departmentId String
  userId       String
  memberId     String
  firstName    String
  lastName     String
  imagePath    String
  jobTitle     JobTitle
  totalScore   Int

  @@unique([departmentId, userId])
}

view DemoOwnerReportView {
  id               String    @unique
  demoId           String
  memberId         String?
  memberJoinedAt   DateTime?
  totalMembers     Int
  totalDepartments Int
  totalCourses     Int
  publishedCourses Int

  totalCertifications Int
  certificationRate   Float
  totalExamAttempts   Int
  examPassRate        Float
  averageExamScore    Float
}

view MemberPerformanceView {
  memberId String @unique
  demoId   String
  userId   String

  fullName String
  email    String
  demoRole DemoMemberRole
  joinedAt DateTime

  departmentIds   String[]
  departmentNames String[]
  departmentRoles DepartmentMemberRole[]
  jobTitles       JobTitle[]

  assignedCourses          Int
  examAttempts             Int
  examsPassed              Int
  examsFailed              Int
  averageScore             Float
  highestScore             Int
  certificationsEarned     Int
  discussionQuestionsCount Int
  discussionAnswersCount   Int
  messagesCount            Int
  inquiriesCount           Int
}

view CoursePerformanceView {
  courseId  String   @unique
  demoId    String
  createdAt DateTime

  courseTitle String
  isPublished Boolean
  visibility  CourseVisibility

  departmentCount      Int
  assignedMemberCount  Int
  sectionCount         Int
  lessonCount          Int
  totalDuration        Int
  examCount            Int
  membersAttempted     Int
  totalAttempts        Int
  averageScore         Float
  passRate             Float
  certificationsIssued Int
  certificationRate    Float
}

view DepartmentPerformanceView {
  departmentId String   @unique
  demoId       String
  createdAt    DateTime

  departmentName String
  manager        String

  memberCount          Int
  assignedCourseCount  Int
  membersWithAttempts  Int
  examAttempts         Int
  averageExamScore     Float
  examPassRate         Float
  certificationsEarned Int
  discussionActivity   Int
  messageActivity      Int
  scheduledLiveStreams Int
  completedLiveStreams Int
}

view DashboardSummaryView {
  id String @unique

  registeredCompaniesCurrent  Int
  registeredCompaniesPrevious Int
  activeLearnersCurrent       Int
  activeLearnersPrevious      Int
  publishedCoursesCurrent     Int
  publishedCoursesPrevious    Int
  completedLearnersCurrent    Int
  completedLearnersPrevious   Int
}

view DashboardLearnerGrowthView {
  id          String   @unique
  period      String
  bucketIndex Int
  date        DateTime
  value       Int
}

view DashboardUserDistributionView {
  id    String @unique
  role  String
  count Int
  total Int
}
