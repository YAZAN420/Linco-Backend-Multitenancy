generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum DemoRole {
  TRAINEE
  MANAGER
}

model User {
  id                    String                 @id
  firstName             String
  lastName              String
  email                 String                 @unique
  password              String
  birthDate             DateTime
  imagePath             String
  refreshToken          String?
  role                  Role                   @default(USER)
  twoFactorSecret       String?
  isTwoFactorEnabled    Boolean                @default(false)
  isEmailVerified       Boolean                @default(false)
  emailVerificationToken String?
  passwordResetToken    String?
  passwordResetExpires  DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  managedDepartments    Department[]
  ownedDemos            Demo[]                 @relation("DemoOwner")
  
  demoMemberships       DemoMember[]
}

model DemoMember {
  id        String   @id 
  userId    String
  demoId    String
  role      DemoRole   @default(TRAINEE)
  joinedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  demo      Demo     @relation(fields: [demoId], references: [id], onDelete: Cascade)

  @@unique([userId, demoId])
}

model Department {
  id         String   @id
  name       String
  managerId  String
  demoId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  manager    User     @relation(fields: [managerId], references: [id])
  demo       Demo     @relation(fields: [demoId], references: [id], onDelete: Cascade)
}

model Demo {
  id           String       @id
  name         String
  ownerId      String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  departments  Department[]
  members      DemoMember[]
  owner        User         @relation("DemoOwner", fields: [ownerId], references: [id])
  
}